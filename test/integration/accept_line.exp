#!/usr/bin/env expect
# Press Enter on a real line over a pty and check that the ZLE rewrite fired.
#
# zsh with -f reads neither /etc/zshrc nor ~/.zshrc, so every setting is typed
# in from here and the result does not depend on what the host has installed.
# Writing an rc file instead lets host configuration, or zsh-newuser-install,
# get in the way and the prompt may never appear.
set timeout 20
set plugin [lindex $argv 0]
set clip   [lindex $argv 1]
set line   [lindex $argv 2]
set extra  [lindex $argv 3]

proc await {what} {
  expect {
    "READY> " {}
    timeout { puts "TIMEOUT: $what"; exit 1 }
    eof     { puts "EOF: $what";     exit 1 }
  }
}

spawn env TERM=vt100 zsh -f -i

# Build the prompt in two steps. Written as PS1='READY> ' the echo of the typed
# line would itself contain "READY> " and could not be told from the prompt.
send -- "p=READY; PS1=\"\${p}> \"\r"
await "prompt"

send -- "YANKER_CLIPBOARD='cat > $clip'\r"
await "clipboard"

if {$extra ne ""} {
  send -- "$extra\r"
  await "extra setup"
}

send -- "source $plugin\r"
await "source"

send -- "$line\r"
await "command"

send -- "exit\r"
expect eof
